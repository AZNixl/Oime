<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Android 11+ 读取 Documents/Oime（方案/字体）需要「所有文件访问」 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 语音输入（轮15）：系统 SpeechRecognizer 录音授权 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 轮19.6：O 圆环上滑快捷启动应用——需读取已安装应用列表（Android 11+ 必须显式声明） -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".AZimeApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AZime"
        tools:targetApi="31">
        
        <!-- Main Activity -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AZime">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Settings Activity -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:theme="@style/Theme.AZime" />
        
        <!-- Keyboard Layout Editor Activity -->
        <activity
            android:name=".ui.editor.KeyboardEditorActivity"
            android:exported="false"
            android:label="@string/keyboard_editor"
            android:theme="@style/Theme.AZime" />

        <!-- Font Manager Activity -->
        <activity
            android:name=".ui.font.FontManagerActivity"
            android:exported="false"
            android:label="字体管理"
            android:theme="@style/Theme.AZime" />

        <!-- Lua Script Editor Activity -->
        <activity
            android:name=".ui.lua.LuaEditorActivity"
            android:exported="false"
            android:label="Lua 脚本"
            android:theme="@style/Theme.AZime" />
        
        <!-- Input Method Service -->
        <service
            android:name=".ime.AZimeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>

</manifest>
